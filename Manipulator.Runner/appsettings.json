{
  "Runner": {
    "ScenarioFile": "", // Path to the scenario JSON, relative to the runner output directory.
    "Scenario": "", // Artifact filename label for this run.
    "Variant": null, // One-based scenario prompt variant; null uses the primary prompt.
    "Approach": "", // Only "mcp" is currently supported.
    "Seed": null, // Optional model seed, when supported by the provider.
    "RunIndex": 0, // Artifact filename index for repeated runs.
    "Batch": "", // Subdirectory under OutDir used for this run's artifacts.
    "OutDir": "", // Output root for telemetry and final-scene files.
    "MaxToolIterations": null, // Maximum model-response turns; null uses the runner default.
    "TimeoutSeconds": null, // Maximum duration in seconds; null uses the scenario default.
    "Models": [] // Enabled model pairs; each needs Name, Provider ("Anthropic" or "OpenAi"), Model, and Enabled.
  }
}
